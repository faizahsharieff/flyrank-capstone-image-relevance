# Local development database defaults; change these for a shared/non-local deployment.
POSTGRES_DB=image_matching
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/image_matching
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_VISION_MAX_ATTEMPTS=3
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
MIN_SIMILARITY=0.75
MIN_CONFIDENCE=0.70